# Build context for `gcloud run deploy --source .`. The Dockerfile needs only
# app/ and config/; everything below is either large or irrelevant to the image.
.git/
.gitignore
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/

.env
.claude-flow/
.veris/

# Docs and demo assets are repo artifacts, not runtime data. The replay clip in
# particular is large and is never read by the container.
*.md
docs/
tests/

# demo/ is excluded EXCEPT the replay sequence, which is load-bearing runtime
# data (§18): the container serves /api/replay/step from it. An image without
# it starts fine and then 500s the moment anyone presses the demo button.
demo/**
!demo/replay-sequence.json
scripts/

.DS_Store
