---
// One screen. No navigation, no landing page, no settings, no auth. PRD §22.
// Server-rendered at build time; the only client JS is /static/app.js (the
// console driver, unchanged) and the Heartbeat island.
import "../styles/global.css";
import "../styles/console.css";
import Heartbeat from "../components/Heartbeat";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RightHook NYC</title>
  </head>
  <body>
    <main class="shell">
      <header class="bar">
        <div>
          <h1>RIGHTHOOK<span class="nyc">NYC</span></h1>
          <p class="sub">
            Proactive vehicle–VRU conflict detection · <span id="camera-name">—</span>
          </p>
        </div>
        <div class="right">
          <span id="mode-badge" class="badge badge-replay">● DEMO REPLAY</span>
          <p class="sub" id="fps-line">— fps · mode pending probe</p>
          <Heartbeat client:load />
        </div>
      </header>

      <section class="split">
        <div class="panel camera">
          <div class="stage">
            <img id="camera-img" alt="NYC DOT traffic camera" />
            <svg id="overlay" viewBox="0 0 352 240" preserveAspectRatio="none"></svg>
          </div>
          <div class="controls">
            <button id="replay-btn" class="btn primary">▶ Run demo replay</button>
            <button id="failover-btn" class="btn">Force camera failure</button>
            <button id="reset-btn" class="btn">Reset</button>
          </div>
          <p class="sub" id="replay-note"></p>
          <p class="legend">
            <span class="key k-vru"></span> VRU approach
            <span class="key k-veh"></span> vehicle turn approach
            <span class="key k-conflict"></span> conflict zone
          </p>
        </div>

        <div class="panel state">
          <h2>INTERSECTION STATE</h2>
          <div class="state-core" aria-live="polite">
            <p class="severity" id="severity">NORMAL</p>
            <p class="sub" id="agent-state">agent state: NORMAL</p>
            <p class="delta" id="delta">—</p>
            <p class="event-flag" id="event-flag"></p>
          </div>
        </div>
      </section>

      <section class="lower">
        <div class="panel strip">
          <h2>RECENT EVENTS</h2>
          <ul id="events" class="events"><li class="muted">No events yet</li></ul>
        </div>
        <div class="lower-side">
          <div class="panel strip">
            <h2>NYC CONTEXT — historical, never affects severity</h2>
            <p id="context-line">Historical context unavailable</p>
            <p class="sub src" id="context-source"></p>
          </div>
          <div class="panel strip system">
            <span id="sys-cloudrun">Cloud Run —</span>
            <span>Zones ✓ calibrated</span>
            <span>Tests 55 passing</span>
          </div>
        </div>
      </section>

      <!-- §12 + §24. Must appear in the UI and the README. -->
      <footer class="disclaimer">
        Heuristic detection from observed zone-entry timestamps · <strong>not a
        calibrated crash probability</strong> · no face or plate recognition, no
        re-identification, no frame storage · replay runs authored observations
        through the live pipeline and is labelled as such
      </footer>
    </main>
    <script src="/static/app.js" is:inline defer></script>
  </body>
</html>
