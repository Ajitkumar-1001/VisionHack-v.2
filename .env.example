# Copy to .env and fill in. NEVER commit real keys (PRD §23, AC-16).
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_WORKSPACE=

# Cloud Run overrides this at runtime.
PORT=8080

# Roboflow Workflow credentials (PRD §9). app/vision/roboflow_client.py and
# scripts/test_feed.py read these. NEVER put a real key in this file — it is
# committed; only .env (gitignored) holds real values.
ROBOFLOW_API_KEY=
# Optional — roboflow_client.py falls back to these if unset.
ROBOFLOW_WORKSPACE=ajit-kumar-khwqb
ROBOFLOW_WORKFLOW_ID=custom-workflow
